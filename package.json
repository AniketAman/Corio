{
  "name": "code-reviewer",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "code-reviewer": "./dist/server/cli.js"
  },
  "scripts": {
    "dev:server": "tsx watch src/cli.ts",
    "dev:client": "vite",
